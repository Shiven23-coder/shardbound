# Copy this file to db.properties (same folder) and fill in your local values.
# db.properties is gitignored: never commit real passwords (CLAUDE.md rule 11).

# Main database used by the game, ContentImporter and ConsoleRunner
db.url=jdbc:postgresql://localhost:5432/shardbound
db.user=postgres
db.password=CHANGE_ME

# Separate database used only by integration tests (SaveRepositoryIT, `mvnw verify`)
test.db.url=jdbc:postgresql://localhost:5432/shardbound_test
test.db.user=postgres
test.db.password=CHANGE_ME

# Javalin HTTP port (the Vite dev server proxies /api here)
app.port=7070

# Demo feature (spec section 4.4): throw after insertInventory to prove rollback
app.simulateSaveCrash=false
