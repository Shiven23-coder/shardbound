{
  "name": "shardbound-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Shardbound UI: renders server views and posts player intents. Types and client come from api/openapi.json.",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.gen.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "pretypecheck": "npm run gen:api",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "prebuild": "npm run gen:api",
    "build": "node node_modules/typescript7/bin/tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run gen:api",
    "test": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^12.23.0",
    "openapi-fetch": "^0.17.0",
    "phaser": "4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
