# Shardbound configuration. Copy to .env (gitignored) or set real environment
# variables. Never commit real secrets (CLAUDE.md rule 8).
#
# Local development needs none of these: `npm run dev` starts PostgreSQL with
# Docker Compose and Spring Boot connects to it automatically.

# --- Local dev (docker-compose.yml) -----------------------------------------
# POSTGRES_PASSWORD=shardbound-dev

# --- Server (production) -----------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.internal:5432/shardbound
SPRING_DATASOURCE_USERNAME=shardbound_app
SPRING_DATASOURCE_PASSWORD=
# Migrations may run as a separate owner role (V2a adds the roles)
# SPRING_FLYWAY_USER=shardbound_owner
# SPRING_FLYWAY_PASSWORD=

# --- Game server tuning (defaults shown) ------------------------------------
# SHARDBOUND_RUN_CACHE_MAX_SIZE=10000
# SHARDBOUND_RUN_CACHE_IDLE_TIMEOUT=30m
# SHARDBOUND_RUN_RETENTION=30d
# SHARDBOUND_CONTENT_DIR=          # read content from a folder instead of the jar
