{
  "$schema": "../schema/audio.schema.json",
  "description": "Sounds and music (P-42, P-57, P-59). Paths are relative to content/audio; files come from tools/audio/prepare.mjs. Volumes are 0-1 before the player's settings. `packs` says when each one downloads.",
  "effects": {
    "rain": {
      "file": "sfx/rain.wav",
      "volume": 0.35,
      "loop": true
    },
    "footstep": {
      "file": "sfx/footstep-grass.wav",
      "volume": 1
    },
    "blip": {
      "file": "sfx/blip.wav",
      "volume": 0.18
    },
    "click": {
      "file": "sfx/click.wav",
      "volume": 0.35
    },
    "battleStart": {
      "file": "sfx/battle-start.wav",
      "volume": 0.45
    },
    "hit": {
      "file": "sfx/hit.wav",
      "volume": 0.55
    },
    "crit": {
      "file": "sfx/crit.wav",
      "volume": 0.6
    },
    "slash": {
      "file": "sfx/slash.wav",
      "volume": 0.45
    },
    "magic": {
      "file": "sfx/magic.wav",
      "volume": 0.45
    },
    "fire": {
      "file": "sfx/fire.wav",
      "volume": 0.45
    },
    "heal": {
      "file": "sfx/heal.wav",
      "volume": 0.45
    },
    "victory": {
      "file": "sfx/victory.wav",
      "volume": 0.5
    },
    "defeat": {
      "file": "sfx/defeat.wav",
      "volume": 0.5
    },
    "lanternKindle": {
      "file": "sfx/lantern-kindle.wav",
      "volume": 0.5
    },
    "lanternRest": {
      "file": "sfx/lantern-rest.wav",
      "volume": 0.45
    },
    "levelUp": {
      "file": "sfx/level-up.wav",
      "volume": 0.5
    },
    "shardsRecovered": {
      "file": "sfx/shards-recovered.wav",
      "volume": 0.5
    },
    "chestOpen": {
      "file": "sfx/chest-open.wav",
      "volume": 0.5
    },
    "heraldPhase": {
      "file": "sfx/herald-phase.wav",
      "volume": 0.55
    }
  },
  "music": {
    "eldmere": {
      "file": "music/eldmere.ogg",
      "fallback": "music/eldmere.m4a",
      "volume": 0.3
    },
    "battle": {
      "file": "music/battle.ogg",
      "fallback": "music/battle.m4a",
      "volume": 0.3
    },
    "herald": {
      "file": "music/herald.ogg",
      "fallback": "music/herald.m4a",
      "volume": 0.32,
      "escalated": { "rate": 1.1, "volume": 0.42 }
    }
  },
  "packs": {
    "description": "When each sound downloads (P-59, P-64): the initial pack with the first page, a region's pack on entering that region, the battle pack only when a creep is near. Initial and battle effects are in exactly one pack; region packs may share effects (the Lantern and chest sounds, P-65), which CI counts in each region pack and the browser downloads once. Each boss has its own pack (packs.bosses), loaded on entering its arena (P-64, P-67). CI budgets each pack on its own.",
    "initial": {
      "effects": ["blip", "click"]
    },
    "regions": {
      "eldmere": {
        "music": "eldmere",
        "effects": ["rain", "footstep", "lanternKindle", "lanternRest", "levelUp", "shardsRecovered", "chestOpen"]
      }
    },
    "battle": {
      "music": "battle",
      "effects": ["battleStart", "hit", "crit", "slash", "magic", "fire", "heal", "victory", "defeat"]
    },
    "bosses": {
      "ashen_herald": {
        "music": "herald",
        "effects": ["heraldPhase"]
      }
    }
  },
  "footstepIntervalMs": 300,
  "footstepPitchJitter": 0.08,
  "blipEveryChars": 8,
  "musicFadeMs": 1500
}
