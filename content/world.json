      "rewardItem": "hunter_longbow", "rewardShards": 30, "rewardGold": 10, "prereqs": [] },
    { "id": "q_blacksmith", "title": "The Smith's Errand", "isMain": false, "giver": "brann",
      "description": "Brann needs iron ore fetched from the quarry before the raid.",
      "rewardItem": "iron_longsword", "rewardShards": 30, "rewardGold": 10, "prereqs": [] },
    { "id": "q_shard_one", "title": "The First Shard", "isMain": true, "giver": "lyra",
      "description": "The Wardens guard a second fragment deep in Whispering Wood.",
      "rewardItem": null, "rewardShards": 80, "rewardGold": 20, "prereqs": ["q_strange_light"] },
    { "id": "q_warden_trial", "title": "Trial of Thorns", "isMain": false, "giver": "lyra",
      "description": "Prove yourself to the Sylvan Wardens.",
      "rewardItem": "thornwood_spear", "rewardShards": 60, "rewardGold": 0, "prereqs": [] },
    { "id": "q_shard_two", "title": "The Second Shard", "isMain": true, "giver": null,
      "description": "The next fragment lies at the bottom of the Hollow Deep.",
      "rewardItem": null, "rewardShards": 120, "rewardGold": 40, "prereqs": ["q_shard_one"] },
    { "id": "q_side_vault", "title": "The Sealed Vault", "isMain": false, "giver": null,
      "description": "A side chamber in the Deep is sealed with an old puzzle lock.",
      "rewardItem": "moonsteel_blade", "rewardShards": 80, "rewardGold": 30, "prereqs": [] },
    { "id": "q_hidden_boss", "title": "What Sleeps Below", "isMain": false, "giver": null,
      "description": "Behind the vault, something enormous is breathing.",
      "rewardItem": "dragonbone_greatsword", "rewardShards": 150, "rewardGold": 60, "prereqs": ["q_side_vault"] },
    { "id": "q_shard_three", "title": "The Third Shard", "isMain": true, "giver": "hale",
      "description": "The King keeps the last fragment in his treasury. Someone in court wants it more.",
      "rewardItem": null, "rewardShards": 160, "rewardGold": 60, "prereqs": ["q_shard_two"] },
    { "id": "q_tournament", "title": "The Royal Tournament", "isMain": false, "giver": "hale",
      "description": "Win the tournament in Valdren City.",
      "rewardItem": "kingsguard_halberd", "rewardShards": 100, "rewardGold": 100, "prereqs": [] },
    { "id": "q_crystal_edge", "title": "The Crystal Edge", "isMain": false, "giver": null,
      "description": "Three shards. One blade. Keep every faction's trust and the Heartshard might become whole.",
      "rewardItem": "aetherion", "rewardShards": 200, "rewardGold": 0,
      "prereqs": ["q_shard_one", "q_shard_two", "q_shard_three"] }
  ],

