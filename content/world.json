      "flask": { "charges": 3, "healPct": 40 } },
    { "id": "energy_tonic", "name": "Azure Tonic", "type": "CONSUMABLE", "price": 15,
      "description": "Fizzing blue water from the forest springs. Restores 10 FP.",
      "consumable": { "heal": 0, "fp": 10 } },

    { "id": "heartshard", "name": "Heartshard", "type": "KEY", "price": 0,
      "description": "A fist-sized crystal that pulses with a slow, warm light, like a sleeping heart." }
