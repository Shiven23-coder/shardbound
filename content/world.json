    { "id": "obj_follow_corvin", "text": "Follow Corvin into Tanner's Alley.",
      "conditions": [{ "type": "FLAG", "key": "following_corvin", "op": "=", "value": 1 }] },
    { "id": "obj_dawn", "text": "Take the crystal to someone in Eldmere Square.",
      "conditions": [{ "type": "FLAG", "key": "dawn", "op": "=", "value": 1 }] },
    { "id": "obj_storm", "text": "Follow the green light to the Old Ruins." }
