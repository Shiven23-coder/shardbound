  "items": [
    { "id": "rusty_shortsword", "name": "Rusty Shortsword", "type": "WEAPON", "price": 5,
      "description": "Your father's old blade. More rust than steel, but it still holds an edge.",
      "weapon": { "tier": "F", "base": 20, "scaling": { "STR": "D", "DEX": "D" }, "critPct": 5, "ability": null } },
    { "id": "woodcutter_hatchet", "name": "Woodcutter's Hatchet", "type": "WEAPON", "price": 20,
      "description": "A short, heavy hatchet with a notched handle. Built for timber, good for worse.",
      "weapon": { "tier": "E", "base": 28, "scaling": { "STR": "C" }, "critPct": 5, "ability": null } },
    { "id": "hunter_longbow", "name": "Hunter's Longbow", "type": "WEAPON", "price": 40,
      "description": "Yew and sinew, strung tight. The grip is worn smooth by a steady hand.",
      "weapon": { "tier": "D", "base": 26, "scaling": { "DEX": "B" }, "critPct": 10, "ability": "Steady Aim" } },
    { "id": "iron_longsword", "name": "Iron Longsword", "type": "WEAPON", "price": 70,
      "description": "Fresh from Brann's forge. Plain, honest, and properly balanced.",
      "weapon": { "tier": "C", "base": 36, "scaling": { "STR": "C", "DEX": "D" }, "critPct": 8, "ability": null } },
    { "id": "thornwood_spear", "name": "Thornwood Spear", "type": "WEAPON", "price": 120,
      "description": "A Warden's spear of living thornwood. Its tip never dulls.",
      "weapon": { "tier": "B", "base": 44, "scaling": { "DEX": "C", "ARC": "D" }, "critPct": 10, "ability": "Briar Reach" } },
    { "id": "moonsteel_blade", "name": "Moonsteel Blade", "type": "WEAPON", "price": 200,
      "description": "Pale metal that drinks the light. Cold to the touch even in summer.",
      "weapon": { "tier": "A", "base": 52, "scaling": { "DEX": "B", "ARC": "C" }, "critPct": 12, "ability": "Moonlit Edge" } },
    { "id": "kingsguard_halberd", "name": "Kingsguard Halberd", "type": "WEAPON", "price": 320,
      "description": "The tournament champion's prize, engraved with the royal stag.",
      "weapon": { "tier": "S", "base": 60, "scaling": { "STR": "B" }, "critPct": 12, "ability": "Royal Sweep" } },
    { "id": "dragonbone_greatsword", "name": "Dragonbone Greatsword", "type": "WEAPON", "price": 500,
      "description": "Carved from the thighbone of something that should not have died.",
      "weapon": { "tier": "SS", "base": 70, "scaling": { "STR": "A" }, "critPct": 15, "ability": "Bone Fury" } },
    { "id": "aetherion", "name": "Aetherion, the Crystal Edge", "type": "WEAPON", "price": 999,
      "description": "The three shards made whole. It hums a note only you can hear.",
      "weapon": { "tier": "SSS", "base": 82, "scaling": { "STR": "C", "DEX": "C", "ARC": "B" }, "critPct": 20, "ability": "Shardstorm" } },

    { "id": "lantern_draught", "name": "Lantern Draught", "type": "FLASK", "price": 0,
