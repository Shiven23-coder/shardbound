{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://shardbound.game/schema/bosses.schema.json",
 "title": "Shardbound bosses (content/bosses.json, V2_SPEC §4.7, P-67)",
 "type": "object",
 "required": [
  "bosses"
 ],
 "additionalProperties": false,
 "properties": {
  "$schema": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "bosses": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "name",
     "family",
     "sprite",
     "level",
     "baseHp",
     "baseAtk",
     "baseDef",
     "baseSpd",
     "phases",
     "onGuardedTelegraph",
     "reward",
     "defeatFlag",
     "introCutscene",
     "epilogueCutscene"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "family": {
      "enum": [
       "BEAST",
       "HUMAN",
       "UNDEAD",
       "SYLVAN",
       "CONSTRUCT",
       "ASHEN",
       "CRYSTALBORN",
       "DRACONIC"
      ]
     },
     "sprite": {
      "type": "string",
      "pattern": "^boss\\.[a-z0-9_]+$"
     },
     "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
     },
     "baseHp": {
      "type": "integer",
      "minimum": 1
     },
     "baseAtk": {
      "type": "integer",
      "minimum": 1
     },
     "baseDef": {
      "type": "integer",
      "minimum": 0
     },
     "baseSpd": {
      "type": "integer",
      "minimum": 1
     },
     "phases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "moves",
        "telegraph",
        "telegraphEvery"
       ],
       "properties": {
        "atPct": {
         "description": "Phase 2 begins at this share of the boss HP, %.",
         "type": "integer",
         "minimum": 1,
         "maximum": 99
        },
        "line": {
         "type": "string",
         "minLength": 1
        },
        "spdDelta": {
         "type": "integer"
        },
        "moves": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "required": [
           "skill",
           "weight"
          ],
          "additionalProperties": false,
          "properties": {
           "skill": {
            "type": "string"
           },
           "weight": {
            "type": "integer",
            "minimum": 1
           }
          }
         }
        },
        "telegraph": {
         "description": "The telegraphed move this phase announces.",
         "type": "string"
        },
        "telegraphEvery": {
         "description": "Every n-th of the boss's moves is the telegraph; it takes two turns, so it is announced every (n + 1)-th round (P-67).",
         "type": "integer",
         "minimum": 1
        }
       }
      }
     },
     "onGuardedTelegraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "status",
       "line",
       "warning",
       "guardDetail"
      ],
      "properties": {
       "status": {
        "enum": [
         "EXPOSED"
        ]
       },
       "line": {
        "type": "string",
        "minLength": 1
       },
       "warning": {
        "type": "string",
        "pattern": "[{]move[}]"
       },
       "guardDetail": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "item",
       "fallbackLevel"
      ],
      "properties": {
       "item": {
        "type": "string"
       },
       "fallbackLevel": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "defeatFlag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
     },
     "introCutscene": {
      "type": "string"
     },
     "epilogueCutscene": {
      "type": "string"
     }
    }
   }
  }
 }
}
