{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shardbound.game/schema/world.schema.json",
  "title": "Shardbound world file (content/world.json)",
  "type": "object",
  "required": [
    "factions",
    "npcs",
    "affinityCues",
    "items",
    "encounters",
    "quests",
    "achievements",
    "endings"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "ELDMERE",
              "SYLVAN",
              "CROWN",
              "ASHEN"
            ]
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "shortName": {
            "description": "How the story cues name the NPC; defaults to name.",
            "$ref": "common.schema.json#/$defs/text"
          },
          "faction": {
            "$ref": "common.schema.json#/$defs/nullableId"
          }
        }
      }
    },
    "affinityCues": {
      "description": "The toast when an NPC's affinity changes: a story cue instead of a number, which stays in the Bag. {name} is the NPC's shortName.",
      "type": "object",
      "required": [
        "warmer",
        "colder"
      ],
      "additionalProperties": false,
      "properties": {
        "warmer": {
          "type": "string",
          "pattern": "\\{name\\}"
        },
        "colder": {
          "type": "string",
          "pattern": "\\{name\\}"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "creep",
          "level"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "canFlee": {
            "type": "boolean"
          },
          "creep": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "An enemy from creeps.json."
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "isMain": {
            "type": "boolean"
          },
          "giver": {
            "$ref": "common.schema.json#/$defs/nullableId"
          },
          "rewardItem": {
            "$ref": "common.schema.json#/$defs/nullableId"
          },
          "rewardGold": {
            "type": "integer",
            "minimum": 0
          },
          "prereqs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "rewardShards": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    },
    "endings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "node",
          "title",
          "priority"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "node": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "viaResolver": {
            "type": "boolean"
          },
          "conditions": {
            "$ref": "common.schema.json#/$defs/conditions"
          }
        }
      }
    },
    "objectives": {
      "description": "The current objective (P-46): one short line; the first entry whose conditions hold is shown, so list the latest story step first and end with one without conditions.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "conditions": {
            "$ref": "common.schema.json#/$defs/conditions"
          }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "type": {
          "enum": [
            "WEAPON",
            "CONSUMABLE",
            "KEY",
            "FLASK"
          ]
        },
        "description": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "price": {
          "type": "integer",
          "minimum": 0
        },
        "weapon": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "tier",
                "base",
                "critPct"
              ],
              "additionalProperties": false,
              "properties": {
                "tier": {
                  "enum": [
                    "F",
                    "E",
                    "D",
                    "C",
                    "B",
                    "A",
                    "S",
                    "SS",
                    "SSS"
                  ]
                },
                "base": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Base attack (V2_SPEC §4.6)."
                },
                "scaling": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Scaling grades; an attribute not listed does not scale.",
                  "properties": {
                    "STR": {
                      "enum": [
                        "S",
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    },
                    "DEX": {
                      "enum": [
                        "S",
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    },
                    "ARC": {
                      "enum": [
                        "S",
                        "A",
                        "B",
                        "C",
                        "D",
                        "E"
                      ]
                    }
                  }
                },
                "critPct": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "ability": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "consumable": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "heal": {
                  "type": "integer",
                  "minimum": 0
                },
                "fp": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "flask": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "A refillable flask (P-63): charges when full, and HP healed per charge as a share of max HP.",
              "required": [
                "charges",
                "healPct"
              ],
              "additionalProperties": false,
              "properties": {
                "charges": {
                  "type": "integer",
                  "minimum": 1
                },
                "healPct": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "WEAPON"
              }
            }
          },
          "then": {
            "required": [
              "weapon"
            ],
            "properties": {
              "weapon": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "CONSUMABLE"
              }
            }
          },
          "then": {
            "required": [
              "consumable"
            ],
            "properties": {
              "consumable": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "FLASK"
              }
            }
          },
          "then": {
            "required": [
              "flask"
            ],
            "properties": {
              "flask": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
