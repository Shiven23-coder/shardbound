{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shardbound.game/schema/statuses.schema.json",
  "title": "Shardbound statuses (content/statuses.json)",
  "type": "object",
  "required": [
    "statuses"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "statuses": {
      "type": "object",
      "required": [
        "BLEED",
        "POISON",
        "BURN",
        "FROST",
        "STUN"
      ],
      "additionalProperties": false,
      "properties": {
        "BLEED": {
          "$ref": "#/$defs/status"
        },
        "POISON": {
          "$ref": "#/$defs/status"
        },
        "BURN": {
          "$ref": "#/$defs/status"
        },
        "FROST": {
          "$ref": "#/$defs/status"
        },
        "STUN": {
          "$ref": "#/$defs/status"
        }
      }
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "required": [
        "name",
        "letter",
        "icon",
        "turns",
        "immuneFamilies"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "letter": {
          "type": "string",
          "pattern": "^[A-Z][a-z]?$"
        },
        "icon": {
          "enum": [
            "drop",
            "skull",
            "flame",
            "flake",
            "star"
          ]
        },
        "turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "burstPct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tickPct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "defencePct": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100
        },
        "speed": {
          "type": "integer",
          "minimum": -20,
          "maximum": 20
        },
        "removedBy": {
          "enum": [
            "PHYSICAL",
            "FIRE",
            "FROST",
            "LIGHTNING",
            "HOLY",
            "CRYSTAL"
          ]
        },
        "skipsTurn": {
          "type": "boolean"
        },
        "immuneTurnsAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "immuneFamilies": {
          "type": "array",
          "items": {
            "enum": [
              "BEAST",
              "HUMAN",
              "UNDEAD",
              "SYLVAN",
              "CONSTRUCT",
              "ASHEN",
              "CRYSTALBORN",
              "DRACONIC"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
