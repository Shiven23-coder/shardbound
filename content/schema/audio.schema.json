{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shardbound.game/schema/audio.schema.json",
  "title": "Shardbound sounds and music (content/audio/audio.json, P-42)",
  "type": "object",
  "required": ["effects", "music", "packs", "footstepIntervalMs", "footstepPitchJitter", "blipEveryChars", "musicFadeMs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "effects": {
      "description": "Sound effects by the name the client plays them by.",
      "type": "object",
      "required": ["rain", "footstep", "blip", "click"],
      "additionalProperties": { "$ref": "#/$defs/sound" }
    },
    "music": {
      "description": "One track per region id (regions.json), plus the battle track and each boss's track.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/track" }
    },
    "packs": {
      "description": "When each sound downloads (P-59, P-64). Initial and battle effects are in exactly one pack; region packs may share effects (the Lantern sounds).",
      "type": "object",
      "required": ["initial", "regions", "battle", "bosses"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "initial": {
          "description": "Loaded with the first page: the interface sounds the title and menus play.",
          "type": "object",
          "required": ["effects"],
          "additionalProperties": false,
          "properties": { "effects": { "$ref": "#/$defs/effectNames" } }
        },
        "regions": {
          "description": "One pack per region id (regions.json), loaded on entering the region: its music and ambience.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/pack" }
        },
        "battle": {
          "description": "Loaded only when a creep is near (P-57): the battle track and the battle effects.",
          "$ref": "#/$defs/pack"
        },
        "bosses": {
          "description": "One pack per boss id (bosses.json), loaded on entering its arena (P-64, P-67): its music and stings.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pack" }
        }
      }
    },
    "footstepIntervalMs": { "description": "Time between footsteps while walking.", "type": "integer", "minimum": 50 },
    "footstepPitchJitter": { "description": "Each step's playback rate varies by up to this share either way.", "type": "number", "minimum": 0, "maximum": 0.5 },
    "blipEveryChars": { "description": "The dialogue typewriter blips once per this many characters.", "type": "integer", "minimum": 1 },
    "musicFadeMs": { "description": "Fade in and out of a region's music.", "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "effectNames": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z]+$" },
      "uniqueItems": true
    },
    "pack": {
      "type": "object",
      "required": ["music", "effects"],
      "additionalProperties": false,
      "properties": {
        "music": { "description": "A track name in `music`.", "type": "string" },
        "effects": { "$ref": "#/$defs/effectNames" }
      }
    },
    "track": {
      "description": "A music track: the OGG, and an AAC fallback for browsers that cannot play OGG (P-48).",
      "type": "object",
      "required": ["file", "fallback", "volume"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^music/[a-z0-9-]+[.]ogg$" },
        "fallback": { "type": "string", "pattern": "^music/[a-z0-9-]+[.]m4a$" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sound": {
      "type": "object",
      "required": ["file", "volume"],
      "additionalProperties": false,
      "properties": {
        "file": { "description": "Path inside content/audio.", "type": "string", "pattern": "^sfx/[a-z0-9-]+[.]wav$" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" }
      }
    }
  }
}
