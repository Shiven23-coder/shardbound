{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shardbound.game/schema/skills.schema.json",
  "title": "Shardbound skills and creep moves (content/skills.json)",
  "type": "object",
  "required": [
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "element",
          "power",
          "fpCost",
          "scaling",
          "unlock",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "element": {
            "enum": [
              "PHYSICAL",
              "FIRE",
              "FROST",
              "LIGHTNING",
              "HOLY",
              "CRYSTAL"
            ]
          },
          "power": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          },
          "fpCost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "scaling": {
            "enum": [
              "WEAPON",
              "MIND",
              "ARCANE"
            ]
          },
          "status": {
            "enum": [
              "BLEED",
              "POISON",
              "BURN",
              "FROST",
              "STUN"
            ]
          },
          "statusChance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "telegraph": {
            "type": "boolean"
          },
          "telegraphLine": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Shown one enemy turn early; {name} is the enemy's name."
          },
          "unlock": {
            "enum": [
              "START",
              "DIALOGUE",
              "LOCKED",
              "CREEP"
            ]
          }
        },
        "if": {
          "properties": {
            "telegraph": {
              "const": true
            }
          },
          "required": [
            "telegraph"
          ]
        },
        "then": {
          "required": [
            "telegraphLine"
          ]
        }
      }
    }
  }
}
