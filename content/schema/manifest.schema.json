{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shardbound.game/schema/manifest.schema.json",
  "title": "Shardbound art manifest (content/art/manifest.json, P-34)",
  "type": "object",
  "required": ["frameSize", "actors", "actorShadow", "sheetLayout"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "frameSize": { "type": "integer", "minimum": 8 },
    "actors": {
      "description": "Sprite keys: player and npc.<npcId>.",
      "type": "object",
      "propertyNames": { "pattern": "^(player|npc\\.[a-z0-9_]+)$" },
      "additionalProperties": {
        "type": "object",
        "required": ["sheet", "faceset"],
        "additionalProperties": false,
        "properties": {
          "sheet": { "$ref": "#/$defs/png" },
          "faceset": { "$ref": "#/$defs/png" }
        }
      }
    },
    "actorShadow": { "$ref": "#/$defs/png" },
    "sheetLayout": {
      "type": "object",
      "required": ["columns", "walkRows"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "columns": {
          "type": "object",
          "required": ["DOWN", "UP", "LEFT", "RIGHT"],
          "additionalProperties": false,
          "properties": {
            "DOWN": { "type": "integer", "minimum": 0 },
            "UP": { "type": "integer", "minimum": 0 },
            "LEFT": { "type": "integer", "minimum": 0 },
            "RIGHT": { "type": "integer", "minimum": 0 }
          }
        },
        "walkRows": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
      }
    }
  },
  "$defs": {
    "png": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.png$" }
  }
}
