  "components" : {
    "schemas" : {
      "AchievementView" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "hidden" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "unlocked" : {
            "type" : "boolean"
          }
        },
        "required" : [ "description", "hidden", "id", "title", "unlocked" ]
      },
      "AffinityView" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "npcId" : {
            "type" : "string"
          },
          "value" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "name", "npcId", "value" ]
      },
      "ChoiceView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int32"
          },
          "label" : {
            "type" : "string"
          },
          "lockReason" : {
            "type" : "string"
          },
          "locked" : {
            "type" : "boolean"
          }
        },
        "required" : [ "id", "label", "locked" ]
      },
      "ChooseRequest" : {
        "type" : "object",
        "properties" : {
          "choiceId" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0
          }
        },
        "required" : [ "choiceId" ]
      },
      "CombatRequest" : {
        "type" : "object",
        "properties" : {
          "itemId" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "target" : {
            "type" : "integer",
            "format" : "int32",
            "minimum" : 0
          },
          "type" : {
            "type" : "string",
            "enum" : [ "ATTACK", "DEFEND", "SKILL", "ITEM", "FLEE" ]
          }
        },
        "required" : [ "target", "type" ]
      },
      "CombatView" : {
        "type" : "object",
        "properties" : {
          "canFlee" : {
            "type" : "boolean"
          },
          "encounterName" : {
            "type" : "string"
          },
          "enemies" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EnemyView"
            }
          },
          "lastHits" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/HitView"
            }
          },
          "log" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "round" : {
            "type" : "integer",
            "format" : "int32"
          },
          "skillCost" : {
            "type" : "integer",
            "format" : "int32"
          },
          "usableItems" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/UsableItem"
            }
          }
        },
        "required" : [ "canFlee", "encounterName", "enemies", "lastHits", "log", "round", "skillCost", "usableItems" ]
      },
      "EndingInfoView" : {
        "type" : "object",
        "properties" : {
          "bestSeconds" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string"
          },
          "reached" : {
            "type" : "boolean"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "reached", "title" ]
      },
      "EndingView" : {
        "type" : "object",
        "properties" : {
          "endingsFound" : {
            "type" : "integer",
            "format" : "int32"
          },
          "endingsTotal" : {
            "type" : "integer",
            "format" : "int32"
          },
          "id" : {
            "type" : "string"
          },
          "seconds" : {
            "type" : "integer",
            "format" : "int32"
          },
          "text" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "endingsFound", "endingsTotal", "id", "seconds", "text", "title" ]
      },
      "EnemyView" : {
        "type" : "object",
        "properties" : {
          "alive" : {
            "type" : "boolean"
          },
          "defending" : {
            "type" : "boolean"
          },
          "hp" : {
            "type" : "integer",
            "format" : "int32"
          },
          "index" : {
            "type" : "integer",
            "format" : "int32"
          },
          "maxHp" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "alive", "defending", "hp", "index", "maxHp", "name" ]
      },
      "GameView" : {
        "type" : "object",
        "properties" : {
          "affinity" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AffinityView"
            }
          },
          "chapter" : {
            "type" : "integer",
            "format" : "int32"
          },
          "choices" : {
